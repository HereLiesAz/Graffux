{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.painterly.water",
  "name": "Painterly Water",
  "version": "1.0.0",
  "kind": "asset",
  "license": "Apache-2.0",
  "compat": ">=0.1",
  "description": "Watercolour brushes for wet-in-wet, washes and granulation: a mop, a wash flat, a wet round, a rigger, a granulating wash, and sponge and rag lifts.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "contributes": {
    "paletteTools": [
      {
        "id": "wet-paint",
        "name": "Wet paint mixer",
        "kind": "wet-paint"
      }
    ]
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/tip-round.png",
      "tags": [
        "painterly",
        "water",
        "bristle"
      ],
      "params": {
        "name": "Mop",
        "spacing": 0.18,
        "opacity": 1,
        "painterly": 1,
        "load": {
          "lanes": 16,
          "depth": 4,
          "capacity": 2.0,
          "fill": []
        },
        "impastoMaterial": {
          "version": 2,
          "enabled": true,
          "initialLoad": 1,
          "wetness": 0.95,
          "pickupRate": 0.3,
          "levelingRate": 0.2,
          "viscosity": 0.1,
          "yieldLikeStrength": 0.05,
          "dryingRate": 0.12,
          "substrateResponse": 0.2,
          "baseRoughness": 0.6,
          "wetSpecularStrength": 0.2,
          "sheen": 0.0
        },
        "substrateResponse": 0.5,
        "program": {
          "state": {
            "d0": 26,
            "dx": 1,
            "dy": 0,
            "lastW": 0.5
          },
          "init": [
            "d0 = diameter;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let sw = 0.5 + (1 - 0.5) * pr;",
            "if (phase != 3) {",
            "  if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "    dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "  }",
            "}",
            "let dl = hypot(dx, dy);",
            "let nx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ny = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = nx; dy = ny;",
            "let ang = atan2(ny, nx);",
            "hide = 1;",
            "let n = clamp(floor(d0 / 2.0), 6, 32);",
            "if (phase != 3) {",
            "  lastW = sw;",
            "  let wspan = d0 * sw * 1.0;",
            "  let cw = wspan / n;",
            "  let len = max(stepPx * 2.4, cw * 2.2);",
            "  for i in 0..32 {",
            "    if (i < n) {",
            "      let u = (i + 0.5) / n - 0.5;",
            "      let e = abs(u) * 2;",
            "      let streak = 0.72 + 0.1 * noise(i * 9.1 + dist / (d0 * 1.6));",
            "      let gate = clamp(loadAmount(u * 2) * 1.5 + 0.25, 0, 1);",
            "      let tooth = noise2(i * 3.7, dist / (d0 * 0.8));",
            "      let on = gate;",
            "      let a = baseAlpha * streak * on;",
            "      if (a > 0.03) {",
            "        emit { x: px - ny * u * wspan, y: py + nx * u * wspan, size: len, tip: clamp(cw * 1.15 / len, 0.05, 1), angle: ang,",
            "               alpha: a, lane: u * 2, draw: stepPx * 0.006, lift: stepPx * 0.0, mixWet: 0.9,",
            "               h: 0.0 + 0.0 * smoothstep(0.55, 0.95, e) };",
            "      }",
            "    }",
            "  }",
            "}",
            "if (phase == 3) {",
            "  let reach = clamp(layerSpeed * 130, 0, d0 * 2.4);",
            "  let wspan = d0 * lastW * 1.0;",
            "  if (reach > 2) {",
            "    for k in 0..8 {",
            "      let f = (k + 1) / 8;",
            "      let w = pow(1 - f, 1.3) * wspan;",
            "      let bx = px + nx * reach * f;",
            "      let by = py + ny * reach * f;",
            "      let seg = reach / 8 * 2.2;",
            "      emit { x: bx, y: by, size: seg, tip: clamp(max(w * 0.45, 1) / seg, 0.05, 1), angle: ang, alpha: baseAlpha * 0.9, lane: 0, draw: stepPx * 0.006 };",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    },

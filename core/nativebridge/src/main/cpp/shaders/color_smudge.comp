#version 450

#ifndef TILE_SIZE
#define TILE_SIZE 16
#endif
layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

layout(binding = 0, rgba8) uniform image2D layerImage;
layout(std430, binding = 1) buffer CarrierBuffer { vec4 carrier[]; };
// Item 11 (Sample Merged): the pre-composited "what the artist can see" buffer, matching
// ColorSmudgeEngine's readSource -- RGBA8 (not R8, unlike the stamp pipeline's alpha-only grain/
// mask tiles) since a composite of other layers needs full colour depth. Sampled only via
// texelFetch (never texture()), which ignores the sampler's filter/wrap state entirely and returns
// the exact texel -- the CLAMP/NEAREST sampler C++ binds here exists for descriptor-type
// consistency with the rest of this codebase's sampled textures, not because texelFetch needs it.
layout(binding = 2) uniform sampler2D sampleSourceTex;

// One pipeline handles all ordered Color Smudge stages. C++ submits phases sequentially with
// compute->compute barriers between them, so every dab reads the pixels written by the previous dab.
layout(push_constant) uniform SmudgePush {
    int phase;          // 0 seed carrier, 1 Smear, 2 Dulling sample, 3 Dulling deposit
    int centerX;
    int centerY;
    int radius;
    int sampleRadius;
    int smearAlpha;
    int originX;
    int originY;
    float soft;
    float smudgeRate;
    float colorRate;
    float opacity;
    float paintR;
    float paintG;
    float paintB;
    float paintA;
    float dilution;    // Procreate-style Dilution: 0 deposits pure paint, 1 deposits the sampled/carried colour.
    // Packed feature flags from VulkanColorSmudge.cpp: +1 = Sample Merged, +2 = pigment RYB mixing.
    // Keeping both in this historical scalar leaves the push-constant ABI/layout unchanged.
    float hasSampleMerged;
} pc;

int featureFlags() {
    return int(pc.hasSampleMerged + 0.5);
}

bool sampleMergedEnabled() {
    return (featureFlags() & 1) != 0;
}

bool pigmentMixingEnabled() {
    return (featureFlags() & 2) != 0;
}

float brushMask(int dx, int dy) {
    float r = float(max(pc.radius, 1));
    float t = length(vec2(float(dx), float(dy))) / r;
    if (t >= 1.0) return 0.0;
    if (t <= 1.0 - pc.soft) return 1.0;
    float u = (1.0 - t) / pc.soft;
    return u * u * (3.0 - 2.0 * u);
}

vec4 rounded8(vec4 v) {
    return round(clamp(v, 0.0, 1.0) * 255.0) / 255.0;
}

vec4 roundedMaterial8(vec4 v) {
    // Kotlin roundToInt() on our non-negative 0..255 channels is half-up. Keep the pigment path's
    // quantisation deterministic against MaterialColor.toArgb() instead of relying on GLSL round's
    // implementation-dependent tie direction. Legacy still uses rounded8() unchanged above.
    return floor(clamp(v, 0.0, 1.0) * 255.0 + 0.5) / 255.0;
}

vec4 lerpArgb(vec4 a, vec4 b, float t, bool includeAlpha) {
    float f = clamp(t, 0.0, 1.0);
    vec4 outColor = mix(a, b, f);
    if (!includeAlpha) outColor.a = a.a;
    return rounded8(outColor);
}

// Exact GLSL translation of core/engine MaterialColorMixer's bounded RGB<->RYB latent transform.
// This is an artist-oriented subtractive approximation, not a spectral/Kubelka-Munk claim.
vec3 rgbToRyb(vec3 rgb) {
    float r = clamp(rgb.r, 0.0, 1.0);
    float g = clamp(rgb.g, 0.0, 1.0);
    float b = clamp(rgb.b, 0.0, 1.0);
    float white = min(r, min(g, b));
    r -= white;
    g -= white;
    b -= white;

    float maxGreen = max(r, max(g, b));
    float yellow = min(r, g);
    r -= yellow;
    g -= yellow;

    if (b > 0.0 && g > 0.0) {
        b *= 0.5;
        g *= 0.5;
    }

    yellow += g;
    b += g;
    float maxYellow = max(r, max(yellow, b));
    if (maxYellow > 0.0) {
        float normal = maxGreen / maxYellow;
        r *= normal;
        yellow *= normal;
        b *= normal;
    }

    return vec3(r + white, yellow + white, b + white);
}

vec3 rybToRgb(vec3 ryb) {
    float r = clamp(ryb.r, 0.0, 1.0);
    float y = clamp(ryb.g, 0.0, 1.0);
    float b = clamp(ryb.b, 0.0, 1.0);
    float white = min(r, min(y, b));
    r -= white;
    y -= white;
    b -= white;

    float maxYellow = max(r, max(y, b));
    float green = min(y, b);
    y -= green;
    b -= green;

    if (b > 0.0 && green > 0.0) {
        b *= 2.0;
        green *= 2.0;
    }

    r += y;
    green += y;
    float maxGreen = max(r, max(green, b));
    if (maxGreen > 0.0) {
        float normal = maxYellow / maxGreen;
        r *= normal;
        green *= normal;
        b *= normal;
    }

    return vec3(r + white, green + white, b + white);
}

vec4 pigmentArgb(vec4 a, vec4 b, float t, bool includeAlpha) {
    float f = clamp(t, 0.0, 1.0);
    if (f <= 0.0) return roundedMaterial8(a);
    if (f >= 1.0) {
        vec4 endpoint = b;
        if (!includeAlpha) endpoint.a = a.a;
        return roundedMaterial8(endpoint);
    }

    vec3 aryb = rgbToRyb(a.rgb);
    vec3 bryb = rgbToRyb(b.rgb);
    vec3 rgb = rybToRgb(mix(aryb, bryb, f));
    float alpha = includeAlpha ? mix(a.a, b.a, f) : a.a;
    return roundedMaterial8(vec4(rgb, alpha));
}

vec4 materialMixArgb(vec4 a, vec4 b, float t, bool includeAlpha) {
    return pigmentMixingEnabled()
        ? pigmentArgb(a, b, t, includeAlpha)
        : lerpArgb(a, b, t, includeAlpha);
}

// Procreate-style Dilution: at dilution=0 (default) returns the raw paint colour, matching flat
// Krita Color Rate exactly; at dilution=1 returns `under` unchanged, so no new pigment reaches the
// canvas even though colorRate is still being "spent" -- mirrors ColorSmudgeEngine.dilutedPigment().
vec4 dilutedPigment(vec4 under) {
    vec4 paint = vec4(pc.paintR, pc.paintG, pc.paintB, pc.paintA);
    return materialMixArgb(under, paint, 1.0 - pc.dilution, true);
}

bool inLayer(ivec2 p) {
    ivec2 size = imageSize(layerImage);
    return p.x >= 0 && p.y >= 0 && p.x < size.x && p.y < size.y;
}

void seedCarrier() {
    int diameter = pc.radius * 2 + 1;
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (local.x >= diameter || local.y >= diameter) return;
    int dx = local.x - pc.radius;
    int dy = local.y - pc.radius;
    ivec2 size = imageSize(layerImage);
    ivec2 src = clamp(ivec2(pc.centerX + dx, pc.centerY + dy), ivec2(0), size - ivec2(1));
    carrier[local.y * diameter + local.x] = imageLoad(layerImage, src);
}

void smearDab() {
    int diameter = pc.radius * 2 + 1;
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (local.x >= diameter || local.y >= diameter) return;
    int dx = local.x - pc.radius;
    int dy = local.y - pc.radius;
    float mask = brushMask(dx, dy);
    if (mask <= 0.0) return;
    ivec2 dstPos = ivec2(pc.centerX + dx, pc.centerY + dy);
    if (!inLayer(dstPos)) return;

    int k = local.y * diameter + local.x;
    vec4 under = imageLoad(layerImage, dstPos);
    // Pickup reads sampleSourceTex when Sample Merged is active; the carrier/under blend basis
    // below always stays on `under` (the active layer's own pixel) regardless -- mirrors
    // ColorSmudgeEngine.smear()'s `pickedUp` (readSource[idx]) vs `under` (pixels[idx]) split
    // exactly. Without Sample Merged, pickedUp == under, reproducing the original single-image path.
    vec4 pickedUp = sampleMergedEnabled() ? texelFetch(sampleSourceTex, dstPos, 0) : under;
    vec4 carried = materialMixArgb(pickedUp, carrier[k], pc.smudgeRate, pc.smearAlpha != 0);
    carrier[k] = carried;
    vec4 outColor = materialMixArgb(under, carried, mask * pc.opacity, pc.smearAlpha != 0);
    if (pc.colorRate > 0.0) {
        vec4 pigment = dilutedPigment(pickedUp);
        outColor = materialMixArgb(outColor, pigment, mask * pc.opacity * pc.colorRate, true);
    }
    imageStore(layerImage, dstPos, outColor);
}

void dullSample() {
    // Exactly one invocation performs the weighted neighbourhood reduction. This correctness-first
    // reduction deliberately matches the CPU reference before any subgroup/tiled optimization.
    if (gl_GlobalInvocationID.x != 0 || gl_GlobalInvocationID.y != 0) return;
    int sr = max(pc.sampleRadius, 1);
    vec4 sum = vec4(0.0);
    float sumW = 0.0;
    for (int dy = -sr; dy <= sr; ++dy) {
        for (int dx = -sr; dx <= sr; ++dx) {
            float distancePx = length(vec2(float(dx), float(dy)));
            if (distancePx > float(sr)) continue;
            ivec2 p = ivec2(pc.centerX + dx, pc.centerY + dy);
            if (!inLayer(p)) continue;
            float weight = clamp(1.0 - distancePx / float(sr), 0.0, 1.0);
            if (weight <= 0.0) continue;
            // Same pickup swap as smearDab(): the weighted-average neighbourhood reduction reads
            // sampleSourceTex when Sample Merged is active, matching ColorSmudgeEngine.dull()'s
            // weightedAverage(readSource, ...) call exactly.
            vec4 texel = sampleMergedEnabled() ? texelFetch(sampleSourceTex, p, 0) : imageLoad(layerImage, p);
            sum += texel * weight;
            sumW += weight;
        }
    }
    if (sumW > 0.0) {
        carrier[0] = rounded8(sum / sumW);
    } else {
        ivec2 p = ivec2(pc.centerX, pc.centerY);
        if (!inLayer(p)) {
            carrier[0] = vec4(0.0);
        } else {
            carrier[0] = sampleMergedEnabled() ? texelFetch(sampleSourceTex, p, 0) : imageLoad(layerImage, p);
        }
    }
}

void dullDeposit() {
    int diameter = pc.radius * 2 + 1;
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (local.x >= diameter || local.y >= diameter) return;
    int dx = local.x - pc.radius;
    int dy = local.y - pc.radius;
    float mask = brushMask(dx, dy);
    if (mask <= 0.0) return;
    ivec2 dstPos = ivec2(pc.centerX + dx, pc.centerY + dy);
    if (!inLayer(dstPos)) return;

    vec4 under = imageLoad(layerImage, dstPos);
    vec4 outColor = materialMixArgb(
        under, carrier[0], mask * pc.opacity * pc.smudgeRate, pc.smearAlpha != 0
    );
    if (pc.colorRate > 0.0) {
        vec4 pigment = dilutedPigment(carrier[0]);
        outColor = materialMixArgb(outColor, pigment, mask * pc.opacity * pc.colorRate, true);
    }
    imageStore(layerImage, dstPos, outColor);
}

void main() {
    if (pc.phase == 0) seedCarrier();
    else if (pc.phase == 1) smearDab();
    else if (pc.phase == 2) dullSample();
    else if (pc.phase == 3) dullDeposit();
}

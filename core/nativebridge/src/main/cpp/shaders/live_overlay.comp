#version 450
// Live-stroke overlay (docs/Native Rendering Engine Design.md §3): turns the painted layer into the
// screen-space image a SurfaceControl layer shows ABOVE the canvas while a stroke is down, so new
// paint reaches the display without waiting for a Compose frame.
//
// The overlay holds only the stroke's own contribution. SRC_OVER is associative, so
//   stroke over (base over below) == the correct result
// and the canvas underneath keeps showing the pre-stroke layer (`base`) the whole time. Both layer
// images are premultiplied RGBA8. For a pixel painted `out` over its pre-stroke value `base`:
//   out = S + base * (1 - Sa)   ->   Sa = 1 - (1 - out.a) / (1 - base.a),  S = out - base * (1 - Sa)
// An opaque base hides everything beneath it, so there the overlay simply shows `out` wherever the
// stroke changed it. Unchanged pixels come out fully transparent.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2D layerImage;   // the engine's live layer
layout(binding = 1, rgba8) uniform image2D baseImage;             // layer as it was at stroke start
layout(binding = 2, rgba8) uniform writeonly image2D overlayImage; // what the display shows

layout(push_constant) uniform Push {
    // Affine map from an overlay pixel centre to layer pixel coordinates:
    //   layer = (row0.x * x + row0.y * y + row0.z, row1.x * x + row1.y * y + row1.z)
    vec4 row0;
    vec4 row1;
    ivec4 region;  // x, y, w, h of the pixels this dispatch covers (overlay space; layer for mode 1)
    int mode;      // 0 = present, 1 = snapshot layer -> base, 2 = clear overlay
} pc;

vec4 strokeContribution(vec4 painted, vec4 base) {
    if (painted == base) return vec4(0.0);
    if (base.a >= 0.999) return vec4(painted.rgb, 1.0);
    float sa = clamp(1.0 - (1.0 - painted.a) / (1.0 - base.a), 0.0, 1.0);
    vec3 s = clamp(painted.rgb - base.rgb * (1.0 - sa), vec3(0.0), vec3(sa));
    return vec4(s, sa);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy) + pc.region.xy;
    if (gl_GlobalInvocationID.x >= uint(pc.region.z) || gl_GlobalInvocationID.y >= uint(pc.region.w)) return;

    if (pc.mode == 1) {
        ivec2 size = imageSize(baseImage);
        if (p.x < size.x && p.y < size.y) imageStore(baseImage, p, imageLoad(layerImage, p));
        return;
    }
    ivec2 overlaySize = imageSize(overlayImage);
    if (p.x >= overlaySize.x || p.y >= overlaySize.y) return;
    if (pc.mode == 2) {
        imageStore(overlayImage, p, vec4(0.0));
        return;
    }
    vec2 c = vec2(p) + vec2(0.5);
    vec2 q = vec2(dot(pc.row0.xyz, vec3(c, 1.0)), dot(pc.row1.xyz, vec3(c, 1.0)));
    ivec2 lp = ivec2(floor(q));
    ivec2 layerSize = imageSize(layerImage);
    vec4 result = vec4(0.0);
    if (lp.x >= 0 && lp.y >= 0 && lp.x < layerSize.x && lp.y < layerSize.y) {
        result = strokeContribution(imageLoad(layerImage, lp), imageLoad(baseImage, lp));
    }
    imageStore(overlayImage, p, result);
}

#version 450
#ifndef TILE_SIZE
#define TILE_SIZE 16
#endif
layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

// Explicit 3×vec4 std430 layout: exactly 48 bytes per dab, matching GpuDab's twelve floats.
// This avoids relying on compiler-specific intuition about the array stride of a scalar-only struct.
// Legacy JNI leaves paint1.z (`resolved`) zero, so existing callers keep using push-constant paint.
// paint1.w is unused by THIS shader's own tip (stamp_masked.comp repurposes the identical byte
// offset as `tipRatio`); a resolved dab (paint1.z >= 0.5) instead carries its per-dab resolved
// hardness there -- see BrushStamps.dynamicDabs/AzphaltBrush.hardness and
// VulkanStampEngine.ResolvedBrushDab.hardness on the Kotlin side. A legacy (unresolved) dab falls
// back to the push-constant `pc.hardness`, matching its pre-existing behavior exactly.
struct Dab {
    vec4 geometry; // x, y, radius, alpha
    vec4 paint0;   // angleDeg, colorR, colorG, colorB
    vec4 paint1;   // colorA, flow, resolved, hardness (resolved dabs only)
};

layout(std430, binding = 0) readonly buffer DabBuffer { Dab dabs[]; };
layout(binding = 1, rgba8) uniform image2D layerImage;

layout(push_constant) uniform PushConstants {
    uint dabCount;
    float hardness;
    float colorR;
    float colorG;
    float colorB;
    float baseAlpha;
    int originX;
    int originY;
    // >0.5 = sequential SRC_OVER build-up in submission order (the historical/Airbrush-style
    // behavior); <=0.5 (the default) = this pixel's single strongest dab wins, composited once --
    // see the doc comment on VulkanStampEngine::stampDabs's `buildUp` parameter for why the
    // default must NOT keep compounding every overlapping dab (a dragged soft round brush would
    // read as hardened well inside its own falloff band, matching
    // StampBrushRenderer.paintRoundDabsMaxCombined's fix for the identical CPU-side bug).
    float buildUp;
} pc;

float stampCoverage(float distFromCenter, float radius, float hardness) {
    if (radius <= 0.0) return 0.0;
    float t = distFromCenter / radius;
    if (t <= hardness) return 1.0;
    if (t >= 1.0) return 0.0;
    if (hardness >= 0.999) return 1.0 - (t - hardness) / 0.001;
    return 1.0 - (t - hardness) / (1.0 - hardness);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + ivec2(pc.originX, pc.originY);
    ivec2 size = imageSize(layerImage);
    if (pixel.x < 0 || pixel.y < 0 || pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 dst = imageLoad(layerImage, pixel);
    vec2 p = vec2(pixel) + vec2(0.5);
    bool sequential = pc.buildUp > 0.5;

    // Max-combine mode (the default) tracks this pixel's single strongest dab across the whole
    // call instead of compositing every overlapping one -- composited onto dst exactly once below,
    // after the loop.
    float bestA = 0.0;
    vec3 bestRgb = vec3(0.0);

    for (uint i = 0u; i < pc.dabCount; i++) {
        Dab d = dabs[i];
        vec2 center = d.geometry.xy;
        float radius = max(d.geometry.z, 0.5);
        float dabAlpha = d.geometry.w;
        if (abs(p.x - center.x) > radius || abs(p.y - center.y) > radius) continue;
        bool hasResolvedPaint = d.paint1.z >= 0.5;
        float dabHardness = hasResolvedPaint ? d.paint1.w : pc.hardness;
        float coverage = stampCoverage(distance(p, center), radius, dabHardness);
        if (coverage <= 0.0) continue;

        vec3 srcRgb = hasResolvedPaint ? d.paint0.yzw : vec3(pc.colorR, pc.colorG, pc.colorB);
        float baseAlpha = hasResolvedPaint ? d.paint1.x : pc.baseAlpha;
        float dabFlow = hasResolvedPaint ? max(d.paint1.y, 0.0) : 1.0;
        float srcA = baseAlpha * dabAlpha * dabFlow * coverage;
        if (srcA <= 0.0) continue;

        if (sequential) {
            dst.rgb = srcRgb * srcA + dst.rgb * (1.0 - srcA);
            dst.a = srcA + dst.a * (1.0 - srcA);
            dst = round(dst * 255.0) / 255.0;
        } else if (srcA > bestA) {
            bestA = srcA;
            bestRgb = srcRgb;
        }
    }
    if (!sequential && bestA > 0.0) {
        dst.rgb = bestRgb * bestA + dst.rgb * (1.0 - bestA);
        dst.a = bestA + dst.a * (1.0 - bestA);
        dst = round(dst * 255.0) / 255.0;
    }
    imageStore(layerImage, pixel, dst);
}

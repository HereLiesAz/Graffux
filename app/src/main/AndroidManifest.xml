<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Photo import for editing. Graffux is a standalone 2D sketch & photo editor. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- firebase-analytics transitively declares AD_ID (advertising ID); we don't use it, and
         leaving it in requires an "app uses advertising ID" declaration in Play Console (Play
         rejected the release: "This release includes the ... AD_ID permission but your
         declaration ... says your app doesn't use advertising ID"). Strip it at merge time
         instead of opting into that declaration. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Held by a conforming azphalt store app to read this host's extension states
         (spec/state-reporting.md § 3.2). Protection level `normal`: the rows carry no identifiers and
         no user content, only which extensions this app has and what it did with them. -->
    <permission
        android:name="azphalt.permission.READ_EXTENSION_STATE"
        android:protectionLevel="normal" />

    <!-- Package visibility (Android 11+): without this, PackageManager#resolveActivity and
         startActivity for the azphalt store's custom action (spec/store-app.md) silently fail to see
         a store app even when one is installed — a custom action isn't covered by the automatic
         visibility exemptions implicit/standard actions get. -->
    <queries>
        <intent>
            <action android:name="store.azphalt.action.BROWSE" />
        </intent>
        <!-- The store chooser's Android option offers to *install* a store app when none is present,
             which means resolving a `market:` intent. Package visibility filters that the same way it
             filters the browse action above: without this the intent can fail to resolve on Android
             11+ even with Play installed, and the user would be silently pushed to the web route
             they did not choose. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- And the web option, for the same reason. `https` is one of the schemes with an automatic
             browser exemption, but declaring it costs nothing and makes the query explicit. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".GraffuxApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Graffux"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- azphalt state reporting (spec/state-reporting.md § 3.2). When the user opens a store app
             directly rather than through Graffux there is no browse request, so no inventory extra
             travels with it and every card would read "Get" — including for extensions already
             installed here. This lets a store re-read the same states out of band.

             Read-only and permission-gated: a store app has no business writing a host's state, and
             the authority is only ever handed out on a browse request (azphalt.extra.STATE_AUTHORITY),
             which the spec requires a store not to query without. Nothing in a row identifies a
             device, a user or an install. -->
        <provider
            android:name="com.hereliesaz.graffitixr.data.azphalt.ExtensionStateProvider"
            android:authorities="${applicationId}.azphalt.state"
            android:exported="true"
            android:readPermission="azphalt.permission.READ_EXTENSION_STATE"
            android:grantUriPermissions="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Graffux">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Interop: receive an image shared from GraffitiXR (e.g. a captured wall photo) to edit. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Interop (share-out): exposes the edited PNG in cacheDir/shared as a content:// Uri so it
             can be sent back to GraffitiXR (or any app) via ACTION_SEND. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

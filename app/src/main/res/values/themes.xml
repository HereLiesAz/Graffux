<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The UI is fully Compose-driven (MaterialTheme supplies colors/typography), so this XML theme
        only has to keep the system chrome out of the way. It is an AppCompat descendant rather than
        a bare platform theme because MainActivity is an AppCompatActivity — which it is so that the
        per-app language setting works below API 33; see MainActivity's own note. AppCompat hard-fails
        with "You need to use a Theme.AppCompat theme (or descendant) with this activity" if this
        parent is ever changed back to a platform theme.
    -->
    <style name="Theme.Graffux" parent="Theme.AppCompat.Light.NoActionBar" />
</resources>

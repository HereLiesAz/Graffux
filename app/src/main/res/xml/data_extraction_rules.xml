<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+) cloud backup and device-to-device transfer rules.

     Installed extensions are code that runs inside Graffux. Restoring them onto another device would
     bring that code over without the install-time confirmation, signature evaluation and trust-store
     check that gated it here, so extensions and everything derived from them stay local; the user
     reinstalls on the new device. The trust cache is re-fetched, and the state store describes
     extensions that will not exist after restore. The entitlement store (and its .bak/.tmp/.corrupt
     siblings) holds the buyer-session cookie, a bearer credential, and is restored from the store
     instead (Restore purchases). Projects and downloaded models are too large for the cloud backup's cap
     (see the comments below) and are left out of it; settings and everything else are backed up as before. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Cloud backup is capped at about 25 MB: over it the whole backup fails, settings included. Projects (layer
             bitmaps) and downloaded models are large, so they stay out of it. -->
        <exclude domain="file" path="projects" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="extensions" />
        <exclude domain="file" path="azphalt-state.json" />
        <exclude domain="file" path="azphalt-trust-keys.json" />
        <exclude domain="file" path="import_staging" />
        <exclude domain="file" path="azphalt-entitlements.json" />
        <exclude domain="file" path="azphalt-entitlements.json.bak" />
        <exclude domain="file" path="azphalt-entitlements.json.tmp" />
        <exclude domain="file" path="azphalt-entitlements.json.corrupt" />
        <exclude domain="sharedpref" path="privacy_consent.xml" />
        <exclude domain="sharedpref" path="stroke_prediction.xml" />
        <exclude domain="sharedpref" path="secure_tokens.xml" />
        <exclude domain="file" path="stroke-data" />
    </cloud-backup>
    <device-transfer>
        <!-- No size cap here, so projects travel with the user to a new phone; downloaded models are fetched again. -->
        <exclude domain="file" path="models" />
        <exclude domain="file" path="extensions" />
        <exclude domain="file" path="azphalt-state.json" />
        <exclude domain="file" path="azphalt-trust-keys.json" />
        <exclude domain="file" path="import_staging" />
        <exclude domain="file" path="azphalt-entitlements.json" />
        <exclude domain="file" path="azphalt-entitlements.json.bak" />
        <exclude domain="file" path="azphalt-entitlements.json.tmp" />
        <exclude domain="file" path="azphalt-entitlements.json.corrupt" />
        <exclude domain="sharedpref" path="privacy_consent.xml" />
        <exclude domain="sharedpref" path="stroke_prediction.xml" />
        <exclude domain="sharedpref" path="secure_tokens.xml" />
        <exclude domain="file" path="stroke-data" />
    </device-transfer>
</data-extraction-rules>

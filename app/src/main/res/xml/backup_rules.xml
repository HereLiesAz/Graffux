<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 10-11 (minSdk 29, targetSdk below 31 semantics). Same exclusions as
     data_extraction_rules.xml: installed extensions are code and must not be restored onto another
     device without passing the install flow again. The entitlement store holds the
     buyer-session cookie, a bearer credential, so it never leaves the device either. -->
<full-backup-content>
    <!-- Auto Backup is capped at about 25 MB per app: over it, the WHOLE backup fails, settings included. Projects
         (layer bitmaps) and downloaded models are large and are the usual way to exceed it, so they stay out. -->
    <exclude domain="file" path="projects" />
    <exclude domain="file" path="models" />
    <exclude domain="file" path="extensions" />
    <exclude domain="file" path="azphalt-state.json" />
    <exclude domain="file" path="azphalt-trust-keys.json" />
    <exclude domain="file" path="import_staging" />
    <exclude domain="file" path="azphalt-entitlements.json" />
    <exclude domain="file" path="azphalt-entitlements.json.bak" />
    <exclude domain="file" path="azphalt-entitlements.json.tmp" />
    <exclude domain="file" path="azphalt-entitlements.json.corrupt" />
    <!-- Consent is per device: never restore it onto a device whose user was not asked. -->
    <exclude domain="sharedpref" path="privacy_consent.xml" />
    <exclude domain="sharedpref" path="stroke_prediction.xml" />
    <!-- The reports token and Figma token, encrypted with a Keystore key that does not travel. -->
    <exclude domain="sharedpref" path="secure_tokens.xml" />
    <exclude domain="file" path="stroke-data" />
</full-backup-content>
